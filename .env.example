# 数据库：SQLite 单文件，放在 data/ 下方便挂卷备份
DATABASE_URL="file:../data/mboard.db"

# 会话签名密钥，生产环境务必改成随机长字符串
AUTH_SECRET="mboard-dev-secret-change-me-please-8f3a9c2e6b1d4f70"

# 账号配置文件路径（相对项目根目录）
ACCOUNTS_FILE="./config/accounts.yml"

# 上传文件目录
UPLOAD_DIR="./data/uploads"

# 站点名称
APP_NAME="MBoard"

# 会话有效期（天）
SESSION_DAYS="7"

# 部署在 HTTPS 反向代理后时设为 true，让 Cookie 只走加密连接
COOKIE_SECURE="false"
