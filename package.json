{
  "name": "mboard",
  "version": "1.0.0",
  "private": true,
  "description": "MBoard - 共享协作工作台（Trello 式看板 + AFFiNE 式无限画布，支持多人实时协作）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "prisma generate && next build",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "hash": "node scripts/hash-password.mjs",
    "warm": "node scripts/warmup.mjs",
    "setup": "prisma generate && prisma db push && node prisma/seed.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@excalidraw/excalidraw": "0.18.1",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "codemirror": "^6.0.2",
    "jose": "6.2.14",
    "lib0": "0.2.119",
    "lucide-react": "1.64.0",
    "next": "15.5.28",
    "prisma": "6.19.3",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "2.6.0",
    "ws": "8.22.0",
    "y-protocols": "1.0.7",
    "yaml": "2.9.1",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "8.18.2",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
